{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["chrome"],
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue", "**/*.d.ts", ".wxt/wxt.d.ts"],
  "exclude": ["node_modules", ".output", "vitest.config.ts", "tests"],
  "vueCompilerOptions": {
    "strictTemplates": true
  }
}
