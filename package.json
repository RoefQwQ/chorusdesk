{
  "name": "chorusdesk",
  "version": "1.0.0",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "description": "Chorus —— 本地优先的多平台创作者动态聚合浏览器扩展（WXT + Vue 3 + MV3）",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoefQwQ/chorusdesk.git"
  },
  "homepage": "https://github.com/RoefQwQ/chorusdesk#readme",
  "bugs": {
    "url": "https://github.com/RoefQwQ/chorusdesk/issues"
  },
  "keywords": [
    "browser-extension",
    "manifest-v3",
    "wxt",
    "vue3",
    "dexie",
    "rss",
    "aggregator"
  ],
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "node e2e/release-gate.mjs",
    "typecheck": "npm run typecheck:ts && npm run typecheck:vue",
    "lint": "eslint .",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:vue": "vue-tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dexie": "^4.4.5",
    "lucide-vue-next": "^0.577.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@wxt-dev/module-vue": "^1.0.3",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11",
    "wxt": "^0.21.4"
  }
}
