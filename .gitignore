# Local and generated files
.output/
.wxt/
node_modules/
# The release workflow's download-page copy of the built zip (dist/chorus-vX.Y.Z.zip).
# Produced by `release.yml`; never a source file.
dist/

# Photos dropped into docs/images for the README, before they are replaced by
# captures from `e2e/screenshots.mjs`. A screenshot of the real app shows real
# accounts, so only the generated ones may be committed.
docs/images/*.png
!docs/images/feed.png
!docs/images/creators.png

